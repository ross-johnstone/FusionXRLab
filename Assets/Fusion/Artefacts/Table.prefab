--- !u!1001 &5347020029650601237
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 4057622884236373629}
    m_Modifications:
    - target: {fileID: 4882262320171367339, guid: c480ee079c800aa42a2a66683d2783ad, type: 3}
      propertyPath: m_text
      value: "Roman Antefix/Tile\n\nReplica of a 2nd\u20133rd century AD roof tile
        with \u201CLEG XX\u201D and the boar emblem of the 20th Legion, based on
        a find from Holt, now in the British Museum. Made by the Legion\u2019s tilery
        in Romano-Britain, these tiles lined roof eaves and marked military presence
        and authority. The 20th Legion, famed for its fierceness, came to Britain
        with Claudius in 43 AD.\n\nHembury Bowl\n\nBased on a pottery sherd from
        Hembury Hillfort, Devon, dated to 3700\u20133400 BCE. The site was a key
        Neolithic gathering place with signs of communal life. The bowl\u2019s handmade
        form reflects simple, functional use and a deep connection to land and craft.\n\nGreek
        Skyphos\n\nReplica of a two-handled Greek wine cup from the Shefton Collection.
        Used in symposia and casual gatherings, the skyphos blends practicality and
        elegance, symbolizing the social value of shared drinking and conversation
        in classical Greece."
      objectReference: {fileID: 0}
    - target: {fileID: 4882262320171367339, guid: c480ee079c800aa42a2a66683d2783ad, type: 3}
      propertyPath: m_fontSize
      value: 4.7
