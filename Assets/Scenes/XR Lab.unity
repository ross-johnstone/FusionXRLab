    - target: {fileID: 7691809521333302881, guid: 2969684ef543a584a83d9c365fc11723, type: 3}
      propertyPath: m_text
      value: "Tokyo   \r\nVisit to Meiji Shrine \u2013 1.5 hr ($10)   \r\nShibuya
        Crossing Exploration \u2013 1 hr ($0)   \r\nAsakusa Temple Visit \u2013 1.5
        hrs ($10)   \r\nSensoji Temple Tour \u2013 1.5 hr ($10)   \r\nTokyo Skytree
        Observation Deck \u2013 1 hr ($50)   \r\nRobot Restaurant Show \u2013 1.5
        hrs ($75)   \r\nHarajuku Shopping Experience \u2013 1 hrs ($50)   \r\nOdaiba
        Shopping and Entertainment \u2013 1.5 hrs ($50)   \r\nAkihabara Electric
        Town Exploration \u2013 1 hr ($10)   \r\nTsukiji Fish Market Visit \u2013
        1 hr ($25)   \r\nShinjuku Gyoen National Garden Walk \u2013 1.5 hr ($0)  
        \r\nTokyo Disneyland Visit \u2013 2 hrs ($100)   \r\nTokyo National Museum
        Tour \u2013 1.5 hrs ($25)   \r\nRoppongi Hills Observation Deck \u2013 1
        hr ($25)   \r\nTraditional Samurai and Katana Experience \u2013 1.5 hrs ($50) 
        \r\nTokyo Bay Cruise \u2013 1.5 hrs ($30)   \r\nGinza Shopping and Dining
        \u2013 2 hrs ($30)   \r\nVisit to Ueno Zoo \u2013 1.5 hrs ($25)   \r\nShinjuku
        Nightlife Tour \u2013 3 hrs ($50)   \r\nVisit to the Imperial Palace \u2013
        1 hr ($15)   \r\nTraditional Tea Ceremony Experience \u2013 1 hr ($25)       
        \r\n\r"
      objectReference: {fileID: 0}
